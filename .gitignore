# Виртуальное окружение (локальные зависимости)
venv/

# База данных SQLite (локальные данные)
db.sqlite3

# Загружаемые пользователями файлы (картинки, документы и т.д.)
media/

# Настройки VS Code (специфичны для твоей машины)
.vscode/

# Настройки IntelliJ IDEA / PyCharm
.idea/

# Кэш и байт-код Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Файлы операционной системы
.DS_Store
Thumbs.db

# Лог-файлы и результаты тестов
*.log
.pytest_cache/